rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /chat_attachments/{userId}/{conversationId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /statuses/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /status/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /vault/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.size <= 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
